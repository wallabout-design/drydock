{
  "name": "@wallabout-design/editor",
  "version": "0.1.0",
  "description": "Client-side editing for wallabout sites: staff edit texts and lists on their own site",
  "license": "UNLICENSED",
  "repository": "github:wallabout-design/editor",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "verify": "npm run check && npm run build && npm run test",
    "release": "node scripts/release.mjs"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "7.0.2",
    "vite": "8.1.7",
    "vitest": "5.0.5"
  }
}
