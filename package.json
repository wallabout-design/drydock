{
  "name": "@wallabout-design/editor",
  "version": "0.2.0",
  "description": "Client-side editing for wallabout sites: staff edit texts and lists on their own site",
  "license": "MIT",
  "repository": "github:wallabout-design/editor",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "migrations"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "default": "./dist/server/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    },
    "./astro": {
      "types": "./dist/astro/index.d.ts",
      "default": "./dist/astro/index.js"
    },
    "./astro/Text.astro": "./dist/astro/Text.astro",
    "./astro/List.astro": "./dist/astro/List.astro",
    "./editor.js": "./dist/editor.js",
    "./editor.css": "./dist/editor.css",
    "./item-form.js": "./dist/item-form.js"
  },
  "scripts": {
    "build": "node scripts/build-assets.mjs && rm -rf dist && tsc -p tsconfig.json && cp src/astro/*.astro dist/astro/ && cp src/editor/*.js src/editor/editor.css dist/",
    "check": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "verify": "npm run check && npm run build && npm run test && npm run test:e2e",
    "release": "node scripts/release.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "typescript": "7.0.2",
    "vite": "8.1.7",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "jose": "6.2.17"
  },
  "peerDependencies": {
    "react": ">=19"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
}
