{
  "name": "@wallabout-design/drydock",
  "version": "0.4.0",
  "description": "Drydock for wallabout sites: staff edit texts and lists on their own site, and reviewers send feedback from any page",
  "license": "MIT",
  "repository": "github:wallabout-design/drydock",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "migrations"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "default": "./dist/server/index.js"
    },
    "./stores/d1": {
      "types": "./dist/stores/d1/index.d.ts",
      "default": "./dist/stores/d1/index.js"
    },
    "./stores/git": {
      "types": "./dist/stores/git/index.d.ts",
      "default": "./dist/stores/git/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    },
    "./astro": {
      "types": "./dist/astro/index.d.ts",
      "default": "./dist/astro/index.js"
    },
    "./astro/Text.astro": "./dist/astro/Text.astro",
    "./astro/List.astro": "./dist/astro/List.astro",
    "./astro/Image.astro": "./dist/astro/Image.astro",
    "./editor.js": "./dist/editor.js",
    "./editor.css": "./dist/editor.css",
    "./item-form.js": "./dist/item-form.js",
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    },
    "./dock": {
      "types": "./dist/dock/staff.d.ts",
      "default": "./dist/dock/staff.js"
    },
    "./feedback": {
      "types": "./dist/feedback/index.d.ts",
      "default": "./dist/feedback/index.js"
    },
    "./feedback/react": {
      "types": "./dist/feedback/react.d.ts",
      "default": "./dist/feedback/react.js"
    },
    "./feedback/reserve.css": "./dist/feedback/reserve.css",
    "./dock": {
      "types": "./dist/dock/index.d.ts",
      "default": "./dist/dock/index.js"
    },
    "./dock/react": {
      "types": "./dist/dock/react.d.ts",
      "default": "./dist/dock/react.js"
    },
    "./dock.css": "./dist/dock/dock.css"
  },
  "scripts": {
    "build": "node scripts/build-assets.mjs && rm -rf dist && tsc -p tsconfig.json && cp src/astro/*.astro dist/astro/ && cp src/editor/*.js src/editor/editor.css dist/ && cp src/feedback/reserve.css dist/feedback/ && cp src/dock/dock.css dist/dock/",
    "check": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "scan:secrets": "bash scripts/scan-secrets.sh",
    "scan:deps": "node scripts/scan-deps.mjs",
    "verify": "npm run check && npm run build && npm run test && npm run scan:secrets && npm run scan:deps && npm run test:e2e",
    "release": "node scripts/release.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "jose": "6.2.17"
  },
  "peerDependencies": {
    "react": ">=19",
    "vitest": ">=5"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "vitest": {
      "optional": true
    }
  }
}
